#
# Forked from mage-os/module-rma 2.4.1 into Magenx_Rma / Magenx_RmaGraphQl;
# identifiers renamed, GraphQL surface split into a sibling module.
# Modified by MagenX: added `customerReturns(sort:)`, the `returnAttributesMetadata` query and its types.
# Modified by MagenX: added the EU withdrawal query and mutation, and the withdrawal fields on CustomerReturn.
#
# Every query below that returns data belonging to one shopper carries
# `@cache(cacheable: false)`. GraphQL GET requests are otherwise stored in the
# full page cache, which is keyed on the query — not on the customer token — so a
# cacheable private query would serve one customer's returns to the next visitor.
# `returnAttributesMetadata` is deliberately left cacheable: it exposes only public
# store configuration and is the same for every visitor of a given store.

type Query {
    customerReturns(
        pageSize: Int = 20
        currentPage: Int = 1
        sort: CustomerReturnsSortInput
    ): CustomerReturnsOutput @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\CustomerReturns") @doc(description: "List return requests for the logged-in customer.") @cache(cacheable: false)

    customerReturn(
        rma_id: Int!
    ): CustomerReturn @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\CustomerReturn") @doc(description: "Get a single return request by ID for the logged-in customer.") @cache(cacheable: false)

    guestReturn(
        order_number: String!
        email: String!
        rma_id: Int!
    ): CustomerReturn @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\GuestReturn") @doc(description: "Get a single return request by ID for a guest order.") @cache(cacheable: false)

    withdrawalOrder(
        order_number: String! @doc(description: "The order increment ID.")
        email: String! @doc(description: "The email address on the order. Not needed to match when the logged-in customer placed the order.")
    ): WithdrawalOrder @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\WithdrawalOrder") @doc(description: "The lines of an order a consumer can still withdraw from (EU right of withdrawal). Open to guests and to registered customers who are not logged in.") @cache(cacheable: false)

    returnComments(
        rma_id: Int!
        pageSize: Int = 50
        currentPage: Int = 1
    ): ReturnCommentsOutput @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\ReturnComments") @doc(description: "List comments for a return request (customer-visible only).") @cache(cacheable: false)

    returnAttributesMetadata: ReturnAttributesMetadata @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\ReturnAttributesMetadata") @doc(description: "Lists the active reasons, resolution types and item conditions a customer or guest can choose from when creating a return.")
}

type Mutation {
    createCustomerReturn(
        input: CreateReturnInput!
    ): CreateReturnOutput @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\CreateCustomerReturn") @doc(description: "Create a return request for a customer order.")

    createGuestReturn(
        input: CreateGuestReturnInput!
    ): CreateReturnOutput @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\CreateGuestReturn") @doc(description: "Create a return request for a guest order.")

    addReturnComment(
        input: AddReturnCommentInput!
    ): ReturnComment @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\AddReturnComment") @doc(description: "Add a comment to a return request.")

    submitWithdrawal(
        input: SubmitWithdrawalInput!
    ): SubmitWithdrawalOutput @resolver(class: "Magenx\\RmaGraphQl\\Model\\Resolver\\SubmitWithdrawal") @doc(description: "Declare withdrawal from an order (EU right of withdrawal). Records the declaration and emails a confirmation, then opens a withdrawal return for shipped items or cancels an order that has not shipped. Open to guests.")
}

type CustomerReturn {
    rma_id: Int @doc(description: "The RMA entity ID.")
    increment_id: String @doc(description: "The RMA increment ID (e.g. RMA-000001).")
    order_number: String @doc(description: "The associated order increment ID.")
    status: ReturnLookupValue @doc(description: "The current RMA status.")
    reason: ReturnLookupValue @doc(description: "The return reason.")
    resolution_type: ReturnLookupValue @doc(description: "The preferred resolution type.")
    items: [ReturnItem] @doc(description: "The items included in this return.")
    comments: [ReturnComment] @doc(description: "Customer-visible comments.")
    created_at: String @doc(description: "Creation date.")
    updated_at: String @doc(description: "Last update date.")
    is_withdrawal: Boolean @doc(description: "True when the return was opened from a withdrawal declaration.")
    withdrawal_declared_at: String @doc(description: "When the withdrawal declaration was received (UTC), for withdrawal returns.")
    helpdesk_ticket_code: String @doc(description: "The support ticket that records the withdrawal declaration.")
    return_carrier: String @doc(description: "Carrier of the return shipment, once known.")
    return_tracking_number: String @doc(description: "Tracking number of the return shipment, once known.")
}

type ReturnItem {
    item_id: Int @doc(description: "The RMA item entity ID.")
    order_item_id: Int @doc(description: "The original order item ID.")
    product_name: String @doc(description: "The product name.")
    product_sku: String @doc(description: "The product SKU.")
    qty_requested: Int @doc(description: "Quantity requested for return.")
    qty_approved: Int @doc(description: "Quantity approved.")
    qty_returned: Int @doc(description: "Quantity returned.")
    condition: ReturnLookupValue @doc(description: "Item condition.")
}

type ReturnComment {
    comment_id: Int @doc(description: "The comment entity ID.")
    author_type: String @doc(description: "Author type: customer or admin.")
    author_name: String @doc(description: "Author display name.")
    comment: String @doc(description: "Comment text.")
    created_at: String @doc(description: "Comment creation date.")
}

type ReturnLookupValue {
    id: Int @doc(description: "Entity ID.")
    code: String @doc(description: "Unique code.")
    label: String @doc(description: "Store-localized label.")
}

type ReturnAttributesMetadata @doc(description: "The selectable lookup values used when creating a return.") {
    reasons: [ReturnLookupValue] @doc(description: "Active return reasons, ordered by sort order.")
    resolution_types: [ReturnLookupValue] @doc(description: "Active resolution types, ordered by sort order.")
    conditions: [ReturnLookupValue] @doc(description: "Active item conditions, ordered by sort order.")
}

input CustomerReturnsSortInput @doc(description: "Specifies which field to sort return requests on, and in which direction.") {
    sort_field: CustomerReturnsSortableField!
    sort_direction: SortEnum!
}

enum CustomerReturnsSortableField @doc(description: "The fields a customer's return requests can be sorted on.") {
    CREATED_AT @doc(description: "Sorts return requests by the date they were created.")
    RMA_ID @doc(description: "Sorts return requests by their RMA id.")
}

type CustomerReturnsOutput {
    items: [CustomerReturn] @doc(description: "List of return requests.")
    total_count: Int @doc(description: "Total number of return requests.")
    page_info: SearchResultPageInfo @doc(description: "Pagination info.")
}

type ReturnCommentsOutput {
    items: [ReturnComment] @doc(description: "List of comments.")
    total_count: Int @doc(description: "Total number of comments.")
    page_info: SearchResultPageInfo @doc(description: "Pagination info.")
}

type CreateReturnOutput {
    return: CustomerReturn @doc(description: "The created return request.")
}

input CreateReturnInput {
    order_id: Int! @doc(description: "The order entity ID.")
    reason_id: Int! @doc(description: "The return reason ID.")
    resolution_type_id: Int! @doc(description: "The preferred resolution type ID.")
    items: [CreateReturnItemInput!]! @doc(description: "Items to return.")
}

input CreateGuestReturnInput {
    order_number: String! @doc(description: "The order increment ID.")
    email: String! @doc(description: "The order billing email.")
    reason_id: Int! @doc(description: "The return reason ID.")
    resolution_type_id: Int! @doc(description: "The preferred resolution type ID.")
    items: [CreateReturnItemInput!]! @doc(description: "Items to return.")
}

input CreateReturnItemInput {
    order_item_id: Int! @doc(description: "The order item ID.")
    qty_requested: Int! @doc(description: "Quantity to return.")
    condition_id: Int @doc(description: "Item condition ID.")
}

input AddReturnCommentInput {
    rma_id: Int! @doc(description: "The RMA entity ID.")
    comment: String! @doc(description: "Comment text.")
}

type WithdrawalOrder @doc(description: "An order as offered on the withdrawal form.") {
    order_number: String @doc(description: "The order increment ID.")
    can_submit: Boolean @doc(description: "Whether submitWithdrawal is available on this store. When false, the storefront should offer its fallback (e.g. a contact form).")
    items: [WithdrawalOrderItem] @doc(description: "Every returnable line of the order, including lines with nothing left to withdraw from.")
}

type WithdrawalOrderItem @doc(description: "One order line on the withdrawal form.") {
    order_item_id: Int @doc(description: "The order item ID, to send back in SubmitWithdrawalInput.")
    name: String @doc(description: "Product name.")
    sku: String @doc(description: "Product SKU.")
    qty_withdrawable: Int @doc(description: "Quantity that can still be withdrawn from: shipped and not returned or refunded, plus not shipped yet.")
    qty_unshipped: Int @doc(description: "Part of qty_withdrawable that has not shipped yet.")
}

input SubmitWithdrawalInput @doc(description: "A withdrawal declaration.") {
    order_number: String! @doc(description: "The order increment ID.")
    email: String! @doc(description: "The email address on the order. Not needed to match when the logged-in customer placed the order. The confirmation is sent to the order's address.")
    name: String! @doc(description: "The declarant's name.")
    items: [WithdrawalItemInput!] @doc(description: "The lines and quantities withdrawn from. Omit or leave empty to withdraw from the whole order.")
    message: String @doc(description: "Optional free text, at most 2000 characters.")
}

input WithdrawalItemInput {
    order_item_id: Int! @doc(description: "The order item ID, from withdrawalOrder.")
    qty: Int! @doc(description: "Quantity withdrawn from.")
}

type SubmitWithdrawalOutput @doc(description: "The recorded declaration.") {
    ticket_code: String @doc(description: "Reference of the recorded declaration, to quote to customer service.")
    received_at: String @doc(description: "When the declaration was received (UTC, Y-m-d H:i:s).")
    return_number: String @doc(description: "Increment ID of the withdrawal return opened for shipped items, when one was opened.")
    order_canceled: Boolean @doc(description: "True when the order had not shipped and was canceled.")
}
