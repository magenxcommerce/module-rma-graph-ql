    Magenx_RmaGraphQl — the GraphQL surface for Magenx_Rma.

    Split out of the backend module so the schema and resolvers can be
    versioned and deployed independently of the admin/REST engine — the same
    pattern Magento uses for Magento_Catalog vs Magento_CatalogGraphQl.
    Magenx_Rma MUST come first in the sequence: the resolvers depend on its
    repositories and services.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_RmaGraphQl">
        <sequence>
            <module name="Magenx_Rma"/>
            <module name="Magento_GraphQl"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Customer"/>
        </sequence>
    </module>
</config>
